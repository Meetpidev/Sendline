# APP_URL: The public URL where this Sendline app is hosted.
# Configure in AI Studio Settings -> Secrets (or your hosting environment).
APP_URL=https://sendline-1.ai.studio

# DATABASE_URL: PostgreSQL connection string (e.g. Neon DB) for persistent multi-user storage.
# Configure this in AI Studio Settings -> Secrets so campaigns, contacts, attachments,
# poll votes, and per-user WhatsApp sessions persist across restarts and deployments.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
